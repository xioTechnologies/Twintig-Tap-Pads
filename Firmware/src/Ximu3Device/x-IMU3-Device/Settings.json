{
    "includes": [
        "<stdbool.h>",
        "<stdint.h>"
    ],
    "settings": [
        {
            "name": "Serial number",
            "declaration": "char name[32]",
            "default": "{\"Unknown\"}",
            "preserved": true
        },
        {
            "name": "Hardware version",
            "declaration": "char name[16]",
            "default": "{\"Unknown\"}",
            "preserved": true
        },
        {
            "name": "Firmware version",
            "declaration": "char name[32]",
            "default": "{\"Unknown\"}",
            "read-only": true
        },
        {
            "name": "Device name",
            "declaration": "char name[32]",
            "default": "{\"Twintig Tap Pads\"}",
            "read-only": false
        },
        {
            "name": "High-pass filter",
            "declaration": "bool name",
            "default": "{true}"
        },
        {
            "name": "Threshold",
            "declaration": "float name",
            "default": "{-0.02f}"
        },
        {
            "name": "Holdoff",
            "declaration": "uint32_t name",
            "default": "{250}"
        },
        {
            "name": "Send ADC data",
            "declaration": "bool name",
            "default": "{true}"
        },
        {
            "name": "Binary mode",
            "declaration": "bool name",
            "default": "{true}"
        }
    ]
}